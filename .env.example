# ---- Required for Met Office (UK) ----
# Weather DataHub > Site Specific > Global Spot subscription. Free tier = 360 calls/day.
MET_OFFICE_API_KEY=

# ---- Required by MET Norway terms: identify your app + a contact ----
METNO_USER_AGENT="uv-europe/0.1 contact@yourdomain.eu"

# ---- Optional: Open-Meteo commercial key (needed if the site is commercial) ----
OPEN_METEO_API_KEY=

# ---- Optional: Météo-France UV forecast API (launched June 2026) ----
# Fill in once you have portal access and the endpoint path from the docs.
METEOFRANCE_UV_URL=
METEOFRANCE_API_KEY=

# ---- Tuning ----
# Minutes between Met Office refreshes. 20 cities x (24h / 180min) = 160 calls/day.
MET_OFFICE_REFRESH_MINUTES=180

# ---- KNMI high-resolution Benelux layer (measured, every 15 min) ----
# Free registered key from developer.dataplatform.knmi.nl
KNMI_API_KEY=
KNMI_UV_DATASET=cloud_modified_UV_index_benelux
KNMI_UV_VERSION=1.0

# ---- Push alerts ----
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@yourdomain.eu
# Any long random string. Vercel Cron sends it automatically.
CRON_SECRET=
# Subscription store (Upstash Redis, EU region). Without it, alerts only work in local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
